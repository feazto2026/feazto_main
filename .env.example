# =====================================================================
# Feazto / Codewild Food Platform — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` or secrets.
#   cp .env.example .env
# Full catalogue: docs/operations/env.md
# =====================================================================

# ---------------------------------------------------------------------
# SERVER-ONLY (Spring Boot API + tooling). Never expose to browsers/apps.
# ---------------------------------------------------------------------

# Supabase Postgres connection string (server-side). Service-role / direct DB.
# Example: postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# Supabase project URL + keys.
# ANON_KEY is public-safe (client use via API layer policy); SERVICE_ROLE_KEY is
# SECRET and server-only (API + scripts/seed). Never put SERVICE_ROLE_KEY in
# VITE_* / EXPO_* / client env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis connection for cache / locks / idempotency / rate limits / OTP throttle.
# Local docker compose service name is `redis`: redis://redis:6379
# Local host-direct (API on host, Redis in Docker): redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Payment provider secrets (server-only). Webhook secret verifies callbacks.
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Back-compat alias used by some scripts/docs:
WEBHOOK_SECRET=

# OTP / session token hashing secret (server-only, min 32 random chars).
OTP_SECRET=

# Optional server tuning
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ---------------------------------------------------------------------
# INFRA / LOCAL PORTS (non-secret, safe to keep as defaults)
# ---------------------------------------------------------------------
REDIS_PORT=6379
ADMIN_WEB_PORT=5173

# ---------------------------------------------------------------------
# CLIENT-SAFE (public). These are baked into bundles — never secrets here.
# ---------------------------------------------------------------------

# Canonical API base for all clients (mobile + admin-web).
# Local default assumes API on host/container port 8080.
API_BASE_URL=http://localhost:8080/api/v1

# Vite admin-web build arg (mirrors API_BASE_URL). Set in .env for compose builds.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Legacy / Expo mobile apps (customer_app, vendor_app, rider_app) read this
# via app config when they are pointed at the platform API:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Supabase public values needed by clients (anon key only — never service-role).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# TEST / SEED CREDENTIALS (local dummy values only — see README_NEW.md)
# ---------------------------------------------------------------------
# E2E / smoke-test accounts used by scripts/verify.sh (local only, no real PII).
TEST_CUSTOMER_PHONE=+910000000001
TEST_VENDOR_PHONE=+910000000002
TEST_RIDER_PHONE=+910000000003
TEST_OTP_CODE=123456
