# Admin Web — environment template.
# Copy to .env.local for local development. Never commit secrets.
# Only VITE_* vars are exposed to the browser bundle.

# Spring Boot API base (no trailing slash). Dev proxy in vite.config.ts
# forwards /api -> this origin when running `npm run dev`.
VITE_API_BASE_URL=http://localhost:8080

# Supabase (client-side anon usage only: auth session helpers / storage
# preview links). All privileged reads/writes go through Spring Boot,
# never direct table mutations from Admin Web.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
